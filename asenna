#!/usr/bin/env bash
# Asennus tuotantokoneelle (Docker + curl; python3 asennetaan tarvittaessa apt:lla).
# Aja repon juuresta: ./asenna   — idempotentti, uudelleenajo on turvallista.
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")"

command -v docker >/dev/null || { echo "docker puuttuu"; exit 1; }
docker compose version >/dev/null || { echo "docker compose -plugin puuttuu"; exit 1; }
command -v curl >/dev/null || { echo "curl puuttuu"; exit 1; }

# cliui (./run, pipelinen ajo) tarvitsee venvin — WebUI ei, se on kontissa.
# Debianin/Ubuntun python3-venv EI sisällä pippiä (ensurepipin bootstrap-wheel
# on karsittu paketista) — ilman python3-pip:iä venv syntyy mutta .venv/bin/pip
# jää tulematta, ilman virhettä. Siksi molemmat aina, ei vain jos venv puuttuu.
sudo apt-get update -qq && sudo apt-get install -y python3-venv python3-pip >/dev/null
[[ -x .venv/bin/pip ]] || { rm -rf .venv; python3 -m venv .venv; }
.venv/bin/pip install -q --upgrade pip
.venv/bin/pip install -q -r requirements.txt

salasana() { head -c 64 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 24; }

if [[ ! -f .env ]]; then
    umask 077
    cat > .env <<ENV
DB_ROOT_PASSWORD=$(salasana)
DB_NAME=opserverdb
DB_USER=opserver
DB_PASSWORD=$(salasana)
WEBUI_AUTH_KAYTTAJA=demo
WEBUI_AUTH_SALASANA=$(salasana)
# Lisää tarvittaessa: LLM_PROVIDER, LLM_API_KEY, LLM_MODEL
ENV
    echo "Luotiin .env satunnaisilla salasanoilla (WEBUI_AUTH_* näkyy siellä)."
fi

# TUOTANTO_DOMAIN: Caddy hakee sille automaattisesti Let's Encrypt -sertin (portti
# 443). Ei autogeneroitavissa — täytyy olla julkinen domain joka osoittaa tähän
# koneeseen (esim. koneen käänteis-DNS-nimi, jos se resolvaa myös eteenpäin takaisin).
grep -q '^TUOTANTO_DOMAIN=' .env 2>/dev/null || {
    echo "Lisää TUOTANTO_DOMAIN=<domain> .env-tiedostoon ja aja ./asenna uudelleen."
    exit 1
}

# LLM_* tarvitaan vain pipelinen seulonta-/arviointivaiheisiin (cliui) — ei WebUI:hin.
grep -q '^LLM_API_KEY=' .env 2>/dev/null || echo "HUOM: LLM_PROVIDER/LLM_API_KEY/LLM_MODEL puuttuu .env:stä — lisää ennen pipelinen ajoa."

docker compose build webui
docker compose up -d

# Migraatiot: alustus.sql on migraatioita edeltävä perusskeema, ei pidetty
# ajan tasalla (ks. tietokanta/migraatio_*.sql). Ajetaan puuttuvat idempotentisti
# — _migraatiot-taulu muistaa jo ajetut, joten uudelleenajo on turvallista.
source .env
aja_sql() { docker compose exec -T mysql mysql -u"$DB_USER" -p"$DB_PASSWORD" "$DB_NAME" "$@"; }
aja_sql -e "CREATE TABLE IF NOT EXISTS _migraatiot (nimi VARCHAR(64) PRIMARY KEY, ajettu DATETIME DEFAULT CURRENT_TIMESTAMP)"
for tiedosto in tietokanta/migraatio_*.sql; do
    nimi=$(basename "$tiedosto")
    ajettu=$(aja_sql -N -e "SELECT 1 FROM _migraatiot WHERE nimi='$nimi'")
    if [[ -z "$ajettu" ]]; then
        echo "Migraatio: $nimi"
        aja_sql < "$tiedosto"
        aja_sql -e "INSERT INTO _migraatiot (nimi) VALUES ('$nimi')"
    fi
done

# Caddyfile on bind-mount — compose ei huomaa pelkkää tiedostomuutosta, joten
# caddy jää ajamaan vanhaa konfiguraatiota ellei sitä erikseen käynnistetä
# uudelleen. Turvallista: sertti on jo /data-volyymissa, restart ei tarvitse
# uutta ACME-kierrosta jos sertti on voimassa.
docker compose restart caddy

# Cron: vahtikoira joka minuutti (korvaa vanhan rivin, ei tuplaa)
rivi="* * * * * $PWD/vahtikoira >> $PWD/vahtikoira.log 2>&1"
( crontab -l 2>/dev/null | grep -vF "$PWD/vahtikoira" || true; echo "$rivi" ) | crontab -
echo "Cron asennettu: $rivi"

# Odota että WebUI vastaa
domain=$(grep -E '^TUOTANTO_DOMAIN=' .env | cut -d= -f2-)
for _ in $(seq 30); do
    ./vahtikoira --hiljaa && { echo "WebUI vastaa: https://$domain — pipeline: .venv/bin/python -m cliui.valikko (tai ./run)"; exit 0; }
    sleep 2
done
echo "WebUI ei vastannut 60 s: docker compose logs"; exit 1
