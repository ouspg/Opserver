#!/usr/bin/env bash
# Vahtikoira (cron, kerran minuutissa): jos WebUI ei vastaa tai kontti on alhaalla,
# aja `docker compose up -d` (käynnistää pysähtyneet). Kova `restart` vasta jos
# epäkunnossa on pysynyt 10 min — mm. Caddyn ensimmäinen sertifikaatin haku
# (ACME) voi kestää tätä pidempään, eikä sitä saa keskeyttää restartilla: se
# tappaa neuvottelun kesken ja polttaa Let's Encryptin failed-authorizations
# -rate limitin (nähty käytännössä — ks. commit-viesti).
# --hiljaa: vain tarkista (exit 0 = kunnossa), älä korjaa.
cd "$(dirname "$(readlink -f "$0")")" || exit 1

# Cron ajaa tämän ilman sudoa — jos käyttäjä ei ole docker-ryhmässä (esr-project),
# bare `docker` epäonnistuu hiljaa eikä terveystarkistus/korjaus toimi ollenkaan.
# EUID-tarkistus: jos joku ajaa tämän käsin sudolla, älä sudota enää sisäisesti
# (turha sisäkkäinen sudo voi varata uuden pty:n, ks. asenna).
if [[ $EUID -eq 0 ]]; then
    docker() { command docker "$@"; }
else
    docker() { sudo docker "$@"; }
fi

TILA_TIEDOSTO="$PWD/.vahtikoira_epakunnossa_alkoi"

kunnossa() {
    [[ "$(docker compose ps --status running --services 2>/dev/null | sort | tr '\n' ' ')" == "caddy mysql webui " ]] || return 1
    # 200 tai 401 (Basic Auth päällä) = palvelin elää. -k: caddyn sertti on
    # myönnetty julkiselle domainille, ei "localhost"ille — sisältö on sama.
    local koodi
    # --max-time 15: raskas ajo (kurssihaku, luokittelu) hidastaa WebUI:n
    # kyselyt sekunneiksi. 5 s tulkitsi kuormituksen epäkunnoksi.
    koodi=$(curl -sk -o /dev/null -w '%{http_code}' --max-time 15 https://localhost/) || return 1
    [[ "$koodi" == 200 || "$koodi" == 401 ]]
}

if kunnossa; then
    rm -f "$TILA_TIEDOSTO"
    exit 0
fi
[[ "${1:-}" == "--hiljaa" ]] && exit 1

echo "$(date -Is) WebUI/MySQL/Caddy alhaalla — käynnistetään pysähtyneet kontit"
docker compose up -d   # ei koske jo käynnissä oleviin — ei keskeytä Caddyn ACME-neuvottelua

if kunnossa; then
    rm -f "$TILA_TIEDOSTO"
    exit 0
fi

nyt=$(date +%s)
alku=$(cat "$TILA_TIEDOSTO" 2>/dev/null || echo "$nyt")
[[ -f "$TILA_TIEDOSTO" ]] || echo "$alku" > "$TILA_TIEDOSTO"

if (( nyt - alku >= 600 )); then
    # MySQL restartataan VAIN jos se on itse epäkunnossa. Kaiken restartointi
    # katkaisi kesken olleen kurssihaun (2055 / "Connection not available"):
    # kuormitettu WebUI näytti epäkunnolta, ja korjaus kaatoi kannan, joka oli
    # kunnossa. Pysähtyneen mysqlin nostaa yllä oleva `up -d`.
    palvelut="caddy webui"
    if [[ "$(docker inspect -f '{{.State.Health.Status}}' "$(docker compose ps -q mysql)" 2>/dev/null)" != "healthy" ]]; then
        palvelut="$palvelut mysql"
    fi
    echo "$(date -Is) yhä alhaalla 10 min jälkeen — restart: $palvelut"
    docker compose restart $palvelut
    rm -f "$TILA_TIEDOSTO"
else
    echo "$(date -Is) yhä alhaalla, odotetaan (ei restarttia vielä)"
fi
